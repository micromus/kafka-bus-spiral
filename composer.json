{
  "name": "micromus/kafka-bus-spiral",
  "description": "This is my package kafka-bus-spiral",
  "keywords": [
    "Micromus",
    "spiral",
    "kafka-bus-spiral"
  ],
  "homepage": "https://github.com/micromus/kafka-bus-spiral",
  "license": "MIT",
  "authors": [
    {
      "name": "Micromus",
      "email": "i@popkovkirill.ru",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "spiral/boot": "^3.7",
    "spiral/console": "^3.7"
  },
  "require-dev": {
    "mockery/mockery": "^1.5",
    "phpunit/phpunit": "^10.1",
    "spiral/testing": "^2.0",
    "vimeo/psalm": "^5.9"
  },
  "autoload": {
    "psr-4": {
      "Micromus\\KafkaBusSpiral\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Micromus\\KafkaBusSpiral\\Tests\\App\\": "tests/app",
      "Micromus\\KafkaBusSpiral\\Tests\\": "tests/src"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm --config=psalm.xml ./src"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "spiral": {
      "bootloaders": [
        "Micromus\\KafkaBusSpiral\\Bootloader\\KafkaBusSpiralBootloader"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
